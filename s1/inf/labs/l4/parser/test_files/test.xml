<?xml version="1.0" encoding="UTF-8"?>
<config>
  <settings-1>
    <enabled>true</enabled>
    <retries>3e-8</retries>
    <ratio>-0.75</ratio>
    <name>example</name>
    <description>Простой набор атрибутов "ЦИТАТА"</description>
  </settings-1>
  <service>
    <frontend>
      <protocol/>
      <healthcheck>
        <path>/health</path>
        <interval>30</interval>
      </healthcheck>
      <tag>
        <item>
          <key>env</key>
          <value>(a-b)>=(1+2-3*4/5)*5/6.1||port.len!=10</value>
        </item>
        <item>
          <key>team</key>
          <value>web</value>
        </item>
      </tag>
      <port>80:80</port>
    </frontend>
  </service>
  <resource>
    <compute>
      <web>
        <user_data>#!/bin/bash
echo "hello"</user_data>
        <ports>
          <item>80</item>
          <item>443</item>
          <item>8080</item>
        </ports>
        <labels>
          <x>y</x>
          <version>1.2.3</version>
          <app>web</app>
        </labels>
        <rules>
          <item>
            <port>80</port>
            <proto>tcp</proto>
          </item>
          <item>
            <port>443</port>
            <proto>tcp</proto>
          </item>
        </rules>
        <disk>
          <item>
            <data>
              <size>100</size>
            </data>
          </item>
          <item>
            <logs>
              <size>50</size>
            </logs>
          </item>
        </disk>
        <network>
          <ingress>
            <item>
              <from>22</from>
              <to>22</to>
            </item>
            <item>
              <from>80</from>
              <to>80</to>
            </item>
          </ingress>
        </network>
        <image_id>var.image_id</image_id>
        <region>${var.region}-1</region>
      </web>
    </compute>
  </resource>
  <variable>
    <item>
      <region>
        <default>eu-central-1</default>
        <type>string</type>
      </region>
    </item>
    <item>
      <image_id>
        <type>string</type>
      </image_id>
    </item>
  </variable>
</config>
